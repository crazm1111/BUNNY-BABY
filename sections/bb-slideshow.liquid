{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
-%}
<div
  class="section section--{{ section.settings.section_width }} bb-section"
  style="--bb-pad-top: {{ section.settings.padding_top }}px; --bb-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <bb-slideshow
    class="bb-slideshow"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.speed | times: 1000 }}"
  >
    <div class="bb-slideshow__track" aria-roledescription="carousel" tabindex="-1">
      {%- for block in slides -%}
        <div
          class="bb-slideshow__slide"
          id="Slide-{{ block.id }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ forloop.length }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {%- capture slide_alt -%}{% render 'bb-text', text: block.settings.alt %}{%- endcapture -%}
            {% render 'bb-picture',
              image: block.settings.image,
              image_mobile: block.settings.image_mobile,
              alt: slide_alt,
              eager: forloop.first
            %}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'bb-picture__img' }}
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if slides.size > 1 -%}
      <div class="bb-slideshow__dots">
        {%- for block in slides -%}
          <button
            type="button"
            class="bb-slideshow__dot"
            data-index="{{ forloop.index0 }}"
            aria-controls="Slide-{{ block.id }}"
            aria-label="{{ forloop.index }} / {{ forloop.length }}"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </bb-slideshow>
</div>

{% javascript %}
  if (!customElements.get('bb-slideshow')) {
    class BBSlideshow extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.bb-slideshow__track');
        this.slides = Array.from(this.querySelectorAll('.bb-slideshow__slide'));
        this.dots = Array.from(this.querySelectorAll('.bb-slideshow__dot'));
        if (this.slides.length < 2) return;

        this.dots.forEach((dot) =>
          dot.addEventListener('click', () => {
            this.goTo(Number(dot.dataset.index));
            this.restart();
          })
        );
        this.track.addEventListener('scroll', () => this.updateDots(), { passive: true });
        this.addEventListener('pointerenter', () => this.stop());
        this.addEventListener('pointerleave', () => this.start());
        this.addEventListener('focusin', () => this.stop());
        this.addEventListener('focusout', () => this.start());

        this.visible = false;
        this.observer = new IntersectionObserver((entries) => {
          this.visible = entries[0].isIntersecting;
          this.visible ? this.start() : this.stop();
        });
        this.observer.observe(this);
      }

      disconnectedCallback() {
        this.stop();
        if (this.observer) this.observer.disconnect();
      }

      get index() {
        const width = this.track.clientWidth || 1;
        return Math.round(Math.abs(this.track.scrollLeft) / width);
      }

      goTo(index) {
        const slide = this.slides[(index + this.slides.length) % this.slides.length];
        const rtl = getComputedStyle(this.track).direction === 'rtl';
        const left = rtl
          ? slide.offsetLeft - (this.track.scrollWidth - this.track.clientWidth)
          : slide.offsetLeft;
        this.track.scrollTo({ left, behavior: 'smooth' });
      }

      updateDots() {
        const current = this.index;
        this.dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)));
      }

      start() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (this.dataset.autoplay !== 'true' || reduce || !this.visible || this.timer) return;
        this.timer = setInterval(() => this.goTo(this.index + 1), Number(this.dataset.speed) || 5000);
      }

      stop() {
        clearInterval(this.timer);
        this.timer = null;
      }

      restart() {
        this.stop();
        this.start();
      }
    }
    customElements.define('bb-slideshow', BBSlideshow);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Bunny Baby slideshow",
  "class": "bb-slideshow-section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Change slides automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Shown on phones. Leave empty to use the desktop image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description (alt text)",
          "info": "Text starting with bunny_baby. is translated from the theme language files."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bunny Baby slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}

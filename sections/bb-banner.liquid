<div
  class="section section--{{ section.settings.section_width }} bb-section"
  style="--bb-pad-top: {{ section.settings.padding_top }}px; --bb-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- capture banner_alt -%}{% render 'bb-text', text: section.settings.alt %}{%- endcapture -%}
  {%- if section.settings.link != blank -%}
    <a class="bb-banner__link" href="{{ section.settings.link }}">
  {%- else -%}
    <div class="bb-banner__link">
  {%- endif -%}
  {%- if section.settings.image != blank -%}
    {% render 'bb-picture',
      image: section.settings.image,
      image_mobile: section.settings.image_mobile,
      alt: banner_alt
    %}
  {%- else -%}
    {{ 'hero-apparel-2' | placeholder_svg_tag: 'bb-picture__img' }}
  {%- endif -%}
  {%- if section.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Bunny Baby banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown on phones. Leave empty to use the desktop image."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image description (alt text)",
      "info": "Text starting with bunny_baby. is translated from the theme language files."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Bunny Baby banner"
    }
  ]
}
{% endschema %}

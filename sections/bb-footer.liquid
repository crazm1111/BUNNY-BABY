{%- liquid
  assign footer_menu = linklists[section.settings.menu]
  assign logo = section.settings.logo | default: settings.logo
-%}
<div
  class="section section--page-width bb-footer"
  style="--bb-pad-top: {{ section.settings.padding_top }}px; --bb-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="bb-footer__inner">
    <div class="bb-footer__col bb-footer__brand">
      <a href="{{ routes.root_url }}" class="bb-footer__logo">
        {%- if logo != blank -%}
          {{
            logo
            | image_url: width: 360
            | image_tag: widths: '180, 360', sizes: '180px', alt: shop.name, loading: 'lazy'
          }}
        {%- else -%}
          <span class="bb-footer__shop-name">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if section.settings.facebook != blank
        or section.settings.instagram != blank
        or section.settings.whatsapp != blank
      -%}
        <p class="bb-footer__heading">{% render 'bb-text', text: section.settings.follow_heading %}</p>
        <ul class="bb-footer__social">
          {%- if section.settings.facebook != blank -%}
            <li>
              <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.4H7.7V13h2.7v8h3.1z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.instagram != blank -%}
            <li>
              <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21 8.1c-.1-1.5-.4-2.8-1.5-3.9S17 2.8 15.5 2.7C14 2.6 10 2.6 8.5 2.7 7 2.8 5.7 3.1 4.6 4.2S3.1 6.6 3 8.1c-.1 1.5-.1 6.3 0 7.8.1 1.5.4 2.8 1.5 3.9s2.4 1.4 3.9 1.5c1.5.1 5.5.1 7 0 1.5-.1 2.8-.4 3.9-1.5s1.4-2.4 1.5-3.9c.1-1.5.1-6.3.2-7.8zm-2 9.6a3 3 0 0 1-1.7 1.7c-1.2.5-3.9.4-5.3.4s-4.1.1-5.3-.4a3 3 0 0 1-1.7-1.7c-.5-1.2-.4-3.9-.4-5.3s-.1-4.1.4-5.3a3 3 0 0 1 1.7-1.7c1.2-.5 3.9-.4 5.3-.4s4.1-.1 5.3.4a3 3 0 0 1 1.7 1.7c.5 1.2.4 3.9.4 5.3s.1 4.1-.4 5.3z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.whatsapp != blank -%}
            <li>
              <a href="{{ section.settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 1.9.8 2.7.9 3.6.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4l-.8-.5zM12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="bb-footer__col">
      <p class="bb-footer__heading">{% render 'bb-text', text: section.settings.about_heading %}</p>
      <p class="bb-footer__about">{% render 'bb-text', text: section.settings.about_text %}</p>
    </div>

    {%- if footer_menu.links.size > 0 -%}
      <nav class="bb-footer__col" aria-label="{{ footer_menu.title | escape }}">
        <p class="bb-footer__heading">{% render 'bb-text', text: section.settings.links_heading %}</p>
        <ul class="bb-footer__links">
          {%- for link in footer_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .bb-footer {
    padding-block: var(--bb-pad-top) var(--bb-pad-bottom);
    background: var(--bb-blue-soft, #eaf3fc);
    color: #333;
  }

  .bb-footer__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 32px;
  }

  .bb-footer__logo img {
    display: block;
    width: 180px;
    height: auto;
  }

  .bb-footer__shop-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bb-pink, #ed3095);
  }

  .bb-footer__heading {
    margin: 0 0 12px;
    color: var(--bb-pink, #ed3095);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .bb-footer__brand .bb-footer__heading {
    margin-top: 16px;
  }

  .bb-footer__about {
    margin: 0;
    line-height: 1.7;
  }

  .bb-footer__links,
  .bb-footer__social {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bb-footer__links li + li {
    margin-top: 6px;
  }

  .bb-footer__links a {
    color: var(--bb-pink, #ed3095);
    text-decoration: none;
  }

  .bb-footer__links a:hover {
    text-decoration: underline;
  }

  .bb-footer__social {
    display: flex;
    gap: 10px;
  }

  .bb-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fff;
    color: var(--bb-blue, #45a0d8);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.08);
  }

  .bb-footer__social svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 749px) {
    .bb-footer__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bunny Baby footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the store logo from theme settings."
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About heading",
      "default": "bunny_baby.footer.about_heading",
      "info": "Text starting with bunny_baby. is translated from the theme language files (Arabic and English). Type your own text to show it in every language."
    },
    {
      "type": "text",
      "id": "about_text",
      "label": "About text",
      "default": "bunny_baby.footer.about_text"
    },
    {
      "type": "text",
      "id": "links_heading",
      "label": "Links heading",
      "default": "bunny_baby.footer.links_heading"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Links menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "follow_heading",
      "label": "Social heading",
      "default": "bunny_baby.footer.follow_heading"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "whatsapp",
      "label": "WhatsApp link",
      "info": "Use https://wa.me/ followed by the number with country code."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Bunny Baby footer"
    }
  ]
}
{% endschema %}

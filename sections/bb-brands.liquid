{%- capture brand_items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.logo != blank -%}
      <li class="bb-brands__item">
        <a
          href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}"
          title="{{ block.settings.collection.title | escape }}"
        >
          {{
            block.settings.logo
            | image_url: width: 220
            | image_tag: class: 'bb-brands__logo', widths: '110, 220', sizes: '110px', alt: block.settings.collection.title, loading: 'lazy'
          }}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="section section--page-width bb-section"
  style="--bb-pad-top: {{ section.settings.padding_top }}px; --bb-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="bb-brands">
    {%- if section.settings.heading != blank -%}
      <h2 class="bb-heading">{% render 'bb-text', text: section.settings.heading %}</h2>
    {%- endif -%}
    <div class="bb-brands__viewport">
      <div class="bb-brands__track" style="--bb-marquee-duration: {{ section.settings.duration }}s;">
        <ul class="bb-brands__list">
          {{ brand_items }}
        </ul>
        {%- comment -%} Second copy makes the scrolling strip loop without a gap. {%- endcomment -%}
        <ul class="bb-brands__list" aria-hidden="true" inert>
          {{ brand_items }}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "bunny_baby.home.trusted_brands",
      "info": "Text starting with bunny_baby. is translated from the theme language files (Arabic and English). Type your own text to show it in every language."
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll speed (seconds per loop)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Brand collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand logos"
    }
  ]
}
{% endschema %}

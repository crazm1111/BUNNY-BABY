{%- liquid
  assign stages = section.blocks | where: 'type', 'stage'
  assign trust_items = section.blocks | where: 'type', 'trust'
-%}
<div
  class="section section--page-width bb-section"
  style="--bb-pad-top: {{ section.settings.padding_top }}px; --bb-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div>
    {%- if stages.size > 0 -%}
      <div class="bb-stages">
        {%- if section.settings.heading != blank -%}
          <h2 class="bb-heading">{% render 'bb-text', text: section.settings.heading %}</h2>
        {%- endif -%}
        <ul class="bb-stages__grid">
          {%- for block in stages -%}
            {%- capture label -%}{% render 'bb-text', text: block.settings.label %}{%- endcapture -%}
            <li class="bb-stages__item" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag: class: 'bb-stages__img', widths: '200, 320, 400', sizes: '160px', alt: '', loading: 'lazy'
                  }}
                {%- elsif block.settings.asset != blank -%}
                  <img
                    class="bb-stages__img"
                    src="{{ block.settings.asset | asset_url }}"
                    width="480"
                    height="480"
                    alt=""
                    loading="lazy"
                  >
                {%- endif -%}
                <span class="bb-stages__label">{{ label }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if trust_items.size > 0 -%}
      <div class="bb-trust{% if stages.size == 0 %} bb-trust--alone{% endif %}">
        <ul class="bb-trust__grid">
          {%- for block in trust_items -%}
            <li class="bb-trust__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag: class: 'bb-trust__icon', widths: '80, 120', sizes: '40px', alt: '', loading: 'lazy'
                }}
              {%- endif -%}
              <span>{% render 'bb-text', text: block.settings.label %}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by stage + trust",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "bunny_baby.home.shop_by_stage",
      "info": "Text starting with bunny_baby. is translated from the theme language files (Arabic and English). Type your own text to show it in every language."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Built-in image file",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust icon",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by stage + trust",
      "blocks": [{ "type": "stage" }, { "type": "stage" }, { "type": "stage" }, { "type": "stage" }]
    }
  ]
}
{% endschema %}

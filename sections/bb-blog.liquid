{%- liquid
  assign blog = section.settings.blog
  assign show_section = true
  if blog == blank or blog.articles_count == 0
    assign show_section = false
  endif
-%}
{%- if show_section or request.design_mode -%}
  <div
    class="section section--page-width bb-section"
    style="--bb-pad-top: {{ section.settings.padding_top }}px; --bb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="bb-blog">
      <div class="bb-blog__header">
        <div>
          <h2 class="bb-heading">{% render 'bb-text', text: section.settings.heading %}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="bb-blog__sub">{% render 'bb-text', text: section.settings.subheading %}</p>
          {%- endif -%}
        </div>
        {%- if blog != blank and section.settings.link_label != blank -%}
          <a class="bb-blog__more" href="{{ blog.url }}">{% render 'bb-text', text: section.settings.link_label %}</a>
        {%- endif -%}
      </div>

      {%- if show_section -%}
        <ul class="bb-blog__grid">
          {%- for article in blog.articles limit: section.settings.limit -%}
            <li>
              <a class="bb-blog__card" href="{{ article.url }}">
                {%- if article.image != blank -%}
                  {{
                    article.image
                    | image_url: width: 600
                    | image_tag: class: 'bb-blog__img', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 70vw', alt: article.image.alt, loading: 'lazy'
                  }}
                {%- else -%}
                  <div class="bb-blog__img"></div>
                {%- endif -%}
                <h3 class="bb-blog__title">{{ article.title | escape }}</h3>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="bb-empty">
          Pick a blog that has articles. This section is hidden on the store until then.
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Blog posts (Mommy corner)",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of articles",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "bunny_baby.home.blog_heading",
      "info": "Text starting with bunny_baby. is translated from the theme language files (Arabic and English). Type your own text to show it in every language."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "bunny_baby.home.blog_subheading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "bunny_baby.home.more_articles"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Blog posts (Mommy corner)"
    }
  ]
}
{% endschema %}

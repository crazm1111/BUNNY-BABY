{%- doc -%}
  "Help on WhatsApp" link. Renders nothing when the theme setting bb_whatsapp_number is empty.

  @param {string} [class] - Extra classes.
{%- enddoc -%}

{%- assign bb_wa_number = settings.bb_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | strip -%}
{%- if bb_wa_number != blank -%}
  <a
    class="bb-whatsapp {{ class }}"
    href="https://wa.me/{{ bb_wa_number }}"
    target="_blank"
    rel="noopener"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 18.7L4 20z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2L9 9.5z" stroke-width="1.4"/></svg>
    <span class="bb-whatsapp__label">{{ 'bb.help.whatsapp' | t }}</span>
  </a>
{%- endif -%}

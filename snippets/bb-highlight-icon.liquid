{%- doc -%}
  Returns the icon name for a highlight key stored in product.metafields.custom.highlights.
  Labels and sentences live in locales under bunny_baby.highlights.<key>.

  @param {string} key - Highlight key, e.g. anti_colic.
{%- enddoc -%}
{%- liquid
  case key
    when 'air_system', 'anti_colic', 'vent_tube'
      echo 'air-vent'
    when 'anti_slip'
      echo 'anchor'
    when 'baby_size'
      echo 'baby'
    when 'portable', 'roll_up'
      echo 'bag'
    when 'glass_bottle'
      echo 'bottle'
    when 'wide_neck'
      echo 'bottle-wide'
    when 'liquid_solid'
      echo 'bowl'
    when 'case', 'hard_case', 'storage_case'
      echo 'box'
    when 'brush_included', 'sponge_tip', 'teat_brush'
      echo 'brush'
    when 'cover'
      echo 'cap'
    when 'easy_use'
      echo 'check'
    when 'one_piece'
      echo 'circle'
    when 'one_hand_lid'
      echo 'click'
    when 'clip'
      echo 'clip'
    when 'divided'
      echo 'columns'
    when 'spare_tips', 'three_pack', 'two_pack'
      echo 'copy'
    when 'slow_flow_s1'
      echo 'drop'
    when 'gel_absorb', 'silicone', 'silicone_100', 'silicone_funnel', 'soft_absorbent', 'soft_tip', 'soft_when_wet', 'water_filled'
      echo 'droplet'
    when 'spill_proof'
      echo 'droplet-off'
    when 'ultra_thin'
      echo 'feather'
    when 'flow_control', 'teat_vents'
      echo 'flow'
    when 'gift'
      echo 'gift'
    when 'teether_section', 'textured'
      echo 'grid'
    when 'ergonomic_grip', 'grasping', 'manual', 'one_hand', 'ribbed_grip'
      echo 'hand'
    when 'handles'
      echo 'handle'
    when 'spare_teat_sizes'
      echo 'layers'
    when 'ph_balanced', 'pure_cotton'
      echo 'leaf'
    when 'leak_proof'
      echo 'lock'
    when 'glow', 'no_handle'
      echo 'moon'
    when 'four_bottles', 'hygienic_pack', 'pairs_pack'
      echo 'package'
    when 'bright_colours'
      echo 'palette'
    when 'write_label'
      echo 'pen'
    when 'pocket'
      echo 'pocket'
    when 'easy_assemble'
      echo 'puzzle'
    when 'long_handle', 'measure', 'size_by_age'
      echo 'ruler'
    when 'curved_blades'
      echo 'scissors'
    when 'chew_resistant', 'no_sharp', 'safety_bud'
      echo 'shield'
    when 'bpa_free', 'food_grade_silicone', 'sterile'
      echo 'shield-check'
    when 'freezer_safe', 'fridge_cool'
      echo 'snowflake'
    when 'keeps_clean', 'wipe_clean'
      echo 'sparkle'
    when 'silicone_tip_spoon', 'snap_spoon', 'spoon_fork', 'spoon_included'
      echo 'spoon'
    when 'hard_spout', 'silicone_spout'
      echo 'spout'
    when 'placemat'
      echo 'square'
    when 'straw'
      echo 'straw'
    when 'keeps_dry'
      echo 'sun'
    when 'two_in_one'
      echo 'swap'
    when 'round_teat', 'silicone_teat', 'symmetrical'
      echo 'teat'
    when 'orthodontic'
      echo 'teat-angled'
    when 'bottle_to_cup', 'self_feeding'
      echo 'trend-up'
    when 'nose_free', 'vent_shield'
      echo 'wind'
    else
      echo 'check'
  endcase
-%}

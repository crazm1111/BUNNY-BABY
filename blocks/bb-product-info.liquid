{%- liquid
  assign bb_mf = closest.product.metafields.custom
  assign bb_box = bb_mf.in_the_box.value | strip | newline_to_br
  assign bb_nl = '<br />'
-%}
{%- if bb_box != blank -%}
  <div class="bb-info" {{ block.shopify_attributes }}>
    <ul>{% assign bb_ls = bb_box | split: bb_nl %}{% for bb_l in bb_ls %}{% assign bb_s = bb_l | strip %}{% if bb_s != blank %}<li>{{ bb_s | escape }}</li>{% endif %}{% endfor %}</ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "BB product info",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "open_first", "label": "Open what's in the box by default", "default": true }
  ],
  "presets": [{ "name": "BB product info", "category": "t:categories.product" }]
}
{% endschema %}

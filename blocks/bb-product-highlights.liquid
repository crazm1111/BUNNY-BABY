{%- doc -%}
  Product highlights: an icon, a short label and one sentence for each key in
  product.metafields.custom.highlights. Hidden when the product has no highlights.
{%- enddoc -%}
{%- assign bb_product = closest.product -%}
{%- assign bb_keys = bb_product.metafields.custom.highlights.value -%}
{%- if bb_keys != blank -%}
  <div class="bb-highlights spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    {%- if block.settings.show_heading -%}
      <h2 class="bb-pdp-heading">{{ 'bunny_baby.product.highlights_heading' | t }}</h2>
    {%- endif -%}
    <ul class="bb-highlights__list" role="list">
      {%- for bb_key in bb_keys limit: block.settings.max_items -%}
        {%- capture bb_icon -%}{% render 'bb-highlight-icon', key: bb_key %}{%- endcapture -%}
        {%- assign bb_label_key = 'bunny_baby.highlights.' | append: bb_key | append: '.label' -%}
        {%- assign bb_text_key = 'bunny_baby.highlights.' | append: bb_key | append: '.text' -%}
        {%- assign bb_label = bb_label_key | t -%}
        {%- if bb_label contains 'translation missing' -%}{%- continue -%}{%- endif -%}
        <li class="bb-highlights__item">
          <span class="bb-highlights__icon">{% render 'bb-lucide', name: bb_icon %}</span>
          <span class="bb-highlights__copy">
            <strong class="bb-highlights__label">{{ bb_label }}</strong>
            {%- if block.settings.show_text -%}
              <span class="bb-highlights__text">{{ bb_text_key | t }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .bb-pdp-heading { font-size: var(--font-h5--size, 1.1rem); margin: 0 0 12px; }
  .bb-highlights__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .bb-highlights__item { display: flex; gap: 10px; align-items: flex-start; padding: 12px; border-radius: 12px; background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.04); }
  .bb-highlights__icon { flex: 0 0 36px; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--color-background, #fff); color: var(--color-primary, currentColor); }
  .bb-highlights__icon .bb-icon { width: 20px; height: 20px; }
  .bb-highlights__copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .bb-highlights__label { font-size: 0.95em; line-height: 1.3; }
  .bb-highlights__text { font-size: 0.85em; line-height: 1.4; opacity: 0.75; }
{% endstylesheet %}

{% schema %}
{
  "name": "BB highlights",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Reads product.metafields.custom.highlights. Hidden when empty." },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": false },
    { "type": "checkbox", "id": "show_text", "label": "Show sentence under each label", "default": true },
    { "type": "range", "id": "max_items", "label": "Most highlights to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "BB highlights", "category": "t:categories.product" }]
}
{% endschema %}

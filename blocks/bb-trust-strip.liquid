{%- doc -%}
  Small row of service promises under the buy buttons. Each item is a
  translation key or plain text; empty items are hidden.
{%- enddoc -%}
{%- liquid
  assign bb_items = ''
  for i in (1..3)
    assign t_id = 'text_' | append: i
    assign bb_t = block.settings[t_id] | strip
    if bb_t != blank
      assign bb_items = bb_items | append: 'x'
    endif
  endfor
-%}
{%- if bb_items != blank -%}
  <ul class="bb-trust spacing-style" role="list" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    {%- for i in (1..3) -%}
      {%- assign t_id = 'text_' | append: i -%}
      {%- assign i_id = 'icon_' | append: i -%}
      {%- assign bb_t = block.settings[t_id] | strip -%}
      {%- if bb_t == blank -%}{%- continue -%}{%- endif -%}
      <li>{% render 'bb-lucide', name: block.settings[i_id] %}<span>{% render 'bb-text', text: bb_t %}</span></li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .bb-trust { list-style: none; margin: 0; padding: 12px 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 0.9em; }
  .bb-trust li { display: flex; align-items: center; gap: 6px; }
  .bb-trust .bb-icon { width: 18px; height: 18px; opacity: 0.8; }
{% endstylesheet %}

{% schema %}
{
  "name": "BB trust strip",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Text can be a translation key starting with bunny_baby. so it shows in Arabic on the Arabic store." },
    { "type": "select", "id": "icon_1", "label": "Icon 1", "default": "truck", "options": [{ "value": "truck", "label": "Truck" }, { "value": "banknote", "label": "Cash" }, { "value": "badge-check", "label": "Badge" }, { "value": "message", "label": "Chat" }, { "value": "shield-check", "label": "Shield" }, { "value": "gift", "label": "Gift" }] },
    { "type": "text", "id": "text_1", "label": "Text 1", "default": "bunny_baby.product.trust_delivery" },
    { "type": "select", "id": "icon_2", "label": "Icon 2", "default": "banknote", "options": [{ "value": "truck", "label": "Truck" }, { "value": "banknote", "label": "Cash" }, { "value": "badge-check", "label": "Badge" }, { "value": "message", "label": "Chat" }, { "value": "shield-check", "label": "Shield" }, { "value": "gift", "label": "Gift" }] },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "bunny_baby.product.trust_cod" },
    { "type": "select", "id": "icon_3", "label": "Icon 3", "default": "badge-check", "options": [{ "value": "truck", "label": "Truck" }, { "value": "banknote", "label": "Cash" }, { "value": "badge-check", "label": "Badge" }, { "value": "message", "label": "Chat" }, { "value": "shield-check", "label": "Shield" }, { "value": "gift", "label": "Gift" }] },
    { "type": "text", "id": "text_3", "label": "Text 3", "default": "bunny_baby.product.trust_original" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "BB trust strip", "category": "t:categories.product" }]
}
{% endschema %}

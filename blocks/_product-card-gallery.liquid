{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    {%- liquid
      # Bunny Friday badge rules (see theme settings → Bunny Friday).
      assign bb_today = 'now' | date: '%Y-%m-%d'
      assign campaign_live = false
      if settings.bb_campaign_on and settings.bb_campaign_end != blank and bb_today <= settings.bb_campaign_end
        assign campaign_live = true
      endif

      assign on_sale = false
      if product.compare_at_price > product.price
        assign on_sale = true
      endif

      assign is_outlet = false
      assign is_sixty = false
      if campaign_live and product.available
        assign outlet_handle = settings.bb_outlet_collection | default: 'outlet'
        assign collection_handles = product.collections | map: 'handle'
        if collection_handles contains outlet_handle or product.tags contains 'badge:Outlet'
          assign is_outlet = true
        endif

        if product.tags contains 'badge:60% OFF'
          assign is_sixty = true
        elsif settings.bb_wee_vendor_rule and product.vendor == settings.bb_wee_vendor
          assign is_sixty = true
        endif
      endif

      assign sixty_label = settings.bb_badge_wee_label | strip
      if sixty_label == blank
        assign sixty_label = 'bb.badge.sixty' | t
      endif
      assign sitewide_label = settings.bb_badge_sitewide_label | strip
      if sitewide_label == blank
        assign sitewide_label = 'bb.badge.fifteen' | t
      endif
    -%}
    {%- if product.available == false -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
            --badge-border-radius: {{ settings.badge_corner_radius }}px;
            --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sold-out">
          {{ 'content.product_badge_sold_out' | t }}
        </div>
      </div>
    {%- elsif campaign_live -%}
      {%- if is_outlet or is_sixty or on_sale -%}
        <div class="product-badges bb-badges">
          {%- if is_outlet -%}
            <span class="bb-badge bb-badge--outlet">{{ 'bb.badge.outlet' | t }}</span>
          {%- endif -%}
          {%- if is_sixty -%}
            <span class="bb-badge bb-badge--sixty">{{ sixty_label }}</span>
          {%- elsif is_outlet == false and on_sale -%}
            <span class="bb-badge bb-badge--fifteen">{{ sitewide_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- elsif on_sale -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
            --badge-border-radius: {{ settings.badge_corner_radius }}px;
            --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sale">
          {{ 'content.product_badge_sale' | t }}
        </div>
      </div>
    {%- endif -%}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{%- if settings.bb_card_vendor and product != blank and product.vendor != blank -%}
  <p class="bb-card-vendor">{{ product.vendor }}</p>
{%- endif -%}

{% # Title for the zoomed out grid view %}
<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
